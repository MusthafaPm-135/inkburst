# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=keyra_comics

# Frontend origin, for example: https://your-site.vercel.app
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Google sign-in (create a Web application OAuth client in Google Cloud)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Razorpay test keys first; use live keys only when you are ready to take payments.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Persistent comic file storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# WhatsApp Cloud API — keep these values private in Render environment variables.
# Use the Graph API version shown in your Meta Developer Hub.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose_a_long_random_private_phrase
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_GRAPH_API_VERSION=vXX.X
